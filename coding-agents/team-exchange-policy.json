{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCoordinatorArchives",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::coding-agents-*/runtime-exchange/coordinator/*"]
    },
    {
      "Sid": "CreateOwnArchives",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::coding-agents-*/runtime-exchange/roles/claude-code/*"],
      "Condition": {"StringEquals": {"s3:if-none-match": "*"}}
    }
  ]
}
